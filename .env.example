# ========================================================
# UKS Digital — contoh konfigurasi
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env
# File `.env` TIDAK boleh masuk git (sudah diabaikan .gitignore).
# ========================================================

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uks_digital

# --- Keamanan ---
# WAJIB diganti dengan teks acak panjang sebelum dipasang di komputer sekolah.
# Token login ditandatangani dengan kunci ini; jika bocor, sesi bisa dipalsukan.
# Contoh cara membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Password akun yang disemai saat database pertama kali dibuat, dan untuk
# akun Admin yang dibuat lewat `npm run seed:admin`.
# Kosongkan untuk memakai default 'admin' — dan segera ganti setelah login.
SEED_ADMIN_PASSWORD=

# Identitas akun Admin (opsional — hanya dipakai oleh `npm run seed:admin`).
# Biarkan kosong untuk memakai nilai bawaan.
SEED_ADMIN_NAMA=
SEED_ADMIN_USERNAME=
SEED_ADMIN_NIP=
SEED_ADMIN_TELEPON=

# --- Server ---
PORT=3000

# Alamat frontend. Dipakai untuk pembatasan CORS dan pengalihan halaman root.
# Saat mode pengembangan: http://localhost:5173
FRONTEND_URL=http://localhost:5173
